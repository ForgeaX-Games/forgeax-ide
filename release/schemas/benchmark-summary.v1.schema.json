{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ForgeaX-Games/forgeax-ide/blob/main/release/schemas/benchmark-summary.v1.schema.json",
  "title": "ForgeaX IDE Release Benchmark Summary v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "identity", "runnerLabels", "sampleSize", "runs", "metrics", "interpretation"],
  "properties": {
    "schema": { "const": "forgeax-ide-release-benchmark-summary/v1" },
    "kind": { "enum": ["baseline", "candidate"] },
    "identity": { "$ref": "benchmark-run.v1.schema.json#/$defs/identity" },
    "runnerLabels": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["job", "labels"],
        "properties": {
          "job": { "type": "string" },
          "labels": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "sampleSize": { "type": "integer", "minimum": 3 },
    "runs": { "type": "array", "minItems": 3, "items": { "$ref": "benchmark-run.v1.schema.json#/$defs/source" } },
    "metrics": {
      "type": "object", "additionalProperties": false,
      "required": ["wallClockMs", "runnerTotalMs", "artifactTransferBytes", "installerBytes", "stages"],
      "properties": {
        "wallClockMs": { "$ref": "#/$defs/distribution" }, "runnerTotalMs": { "$ref": "#/$defs/distribution" },
        "artifactTransferBytes": { "$ref": "#/$defs/distribution" }, "installerBytes": { "$ref": "#/$defs/distribution" },
        "stages": { "type": "object", "additionalProperties": { "$ref": "#/$defs/distribution" } }
      }
    },
    "interpretation": {
      "type": "object", "additionalProperties": false,
      "required": ["estimator", "hostedRunnerVariance"],
      "properties": { "estimator": { "const": "median" }, "hostedRunnerVariance": { "const": "Report min/max/rangePercent for every metric; do not infer deterministic gains from a single run." } }
    }
  },
  "$defs": {
    "distribution": {
      "type": "object", "additionalProperties": false,
      "required": ["values", "min", "median", "max", "rangePercent"],
      "properties": {
        "values": { "type": "array", "minItems": 3, "items": { "type": "number", "minimum": 0 } },
        "min": { "type": "number", "minimum": 0 }, "median": { "type": "number", "minimum": 0 }, "max": { "type": "number", "minimum": 0 },
        "rangePercent": { "type": "number", "minimum": 0 }
      }
    }
  }
}
