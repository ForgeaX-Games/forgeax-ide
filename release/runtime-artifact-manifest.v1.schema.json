{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgeax.dev/contracts/runtime-artifact-manifest.v1.schema.json",
  "title": "ForgeaX Runtime Artifact Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "algorithm", "artifactId", "producer", "inputs", "scope", "target", "files", "digest"],
  "properties": {
    "schema": { "const": "forgeax-runtime-artifact/v1" },
    "algorithm": { "const": "sha256" },
    "artifactId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*/v[1-9][0-9]*$" },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "tree"],
      "properties": {
        "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "revision": { "$ref": "#/$defs/revision" },
        "tree": { "$ref": "#/$defs/revision" }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lockfiles", "buildScripts", "toolchains"],
      "properties": {
        "lockfiles": { "$ref": "#/$defs/identityFiles" },
        "buildScripts": { "$ref": "#/$defs/identityFiles" },
        "toolchains": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[a-z][a-z0-9._-]*$" },
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    },
    "scope": { "enum": ["common", "target"] },
    "target": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["platform", "triple"],
          "properties": {
            "platform": { "type": "string", "minLength": 1 },
            "triple": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size", "executable"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/sha256" },
          "size": { "type": "integer", "minimum": 0 },
          "executable": { "type": "boolean" }
        }
      }
    },
    "digest": { "$ref": "#/$defs/sha256" }
  },
  "allOf": [
    {
      "if": { "properties": { "scope": { "const": "common" } }, "required": ["scope"] },
      "then": { "properties": { "target": { "type": "null" } } }
    },
    {
      "if": { "properties": { "scope": { "const": "target" } }, "required": ["scope"] },
      "then": { "properties": { "target": { "type": "object" } } }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "revision": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "identityFiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    }
  }
}
