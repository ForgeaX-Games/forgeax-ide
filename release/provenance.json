{
  "schemaVersion": 1,
  "productId": "forgeax-ide",
  "sourceRepository": "ForgeaX-Games/forgeax-ide",
  "releaseRepository": "ForgeaX-Games/forgeax-studio",
  "sourcePolicy": "registry-release-only",
  "platform": {
    "package": "@forgeax/extension-platform",
    "version": "0.4.0",
    "registry": "https://registry.npmjs.org/"
  },
  "immutableInputs": [
    "ideRevision:declared-branch-reachable",
    "integrationRevision:declared-branch-reachable",
    "sidecarCandidateManifest:sha256-bound"
  ],
  "verification": [
    "bun run release:preflight",
    "bun run check:release-sources",
    "bun run verify:release-revisions",
    "bun run diagnostics -- --json",
    "bun run validate:desktop:resources",
    "bun run verify:release-candidate"
  ]
}
