{
	"name": "@forgeax/ide",
	"version": "0.3.31-alpha.6",
	"packageManager": "bun@1.4.2",
	"private": true,
	"description": "ForgeaX Web and Desktop product assembly",
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"dev": "bun run prepare:app-shell && vite --configLoader runner --host 127.0.0.1",
		"dev:web": "bun run prepare:app-shell && vite --configLoader runner --host 127.0.0.1 --port 18920",
		"dev:desktop": "bun run prepare:app-shell && bun run tauri dev --config src-tauri/tauri.dev.conf.json",
		"dev:desktop:webdriver": "bun run prepare:app-shell && bun run tauri dev --config src-tauri/tauri.dev.conf.json --config src-tauri/tauri.webdriver.conf.json --features embedded-webdriver",
		"tauri": "tauri",
		"prepare:interface-types": "bun run prepare:app-shell && bun run --cwd ../interface build:package",
		"prepare:shader-build-inputs": "bun run scripts/ensure-shader-build-inputs.ts",
		"verify:shader-vite-contract": "bun run scripts/verify-shader-vite-contract.ts",
		"build:web": "bun run prepare:shader-build-inputs && bun run scripts/build-web.ts",
		"build:desktop": "bun run tauri build",
		"prepare:desktop": "bun run scripts/prepare-desktop.ts",
		"test": "vitest run --project unit && bun run test:bun",
		"typecheck": "bun run prepare:shader-build-inputs && bun run prepare:interface-types && tsc --noEmit -p tsconfig.lint.json",
		"lint": "bun run lint:types && bun run lint:biome",
		"check:web": "bun run scripts/check-web.ts",
		"ci:desktop": "bun run scripts/ci-desktop.ts",
		"diagnostics": "bun run scripts/diagnostics.ts",
		"check:release-sources": "bun run scripts/check-release-sources.ts",
		"release:preflight": "bun run scripts/release-preflight.ts",
		"sync:release-version": "bun run scripts/sync-release-version.ts",
		"resolve:release-context": "bun run scripts/resolve-release-context.ts",
		"verify:release-revisions": "bun run scripts/verify-release-revisions.ts",
		"stage:release-sidecar": "bun run scripts/stage-release-sidecar.ts",
		"artifact:manifest": "bun run scripts/artifact-manifest-cli.ts",
		"artifact:engine-runtime": "bun run scripts/engine-runtime-artifacts.ts",
		"artifact:web": "bun run scripts/web-runtime-artifact.ts",
		"artifact:desktop-runtime": "bun run scripts/runtime-artifacts.ts",
		"measure:release-stage": "bun run scripts/measure-release-stage.ts",
		"benchmark:release": "bun run scripts/release-benchmark.ts",
		"compose:desktop-resources": "bun run scripts/compose-desktop-resources.ts",
		"validate:desktop:resources": "bun run scripts/validate-desktop-resources.ts",
		"verify:desktop:engine-dependencies": "bun run scripts/desktop-engine-dependencies.ts",
		"check:release-secrets": "bun run scripts/check-release-secrets.ts",
		"smoke:production-bundle": "node scripts/smoke-production-bundle.mjs",
		"smoke:desktop-runtime": "bun run scripts/smoke-assembled-desktop-runtime.ts",
		"benchmark:desktop-runtime": "bun run scripts/benchmark-assembled-desktop-runtime.ts",
		"smoke:native-desktop": "bun run scripts/smoke-native-desktop.ts",
		"ci:native-desktop": "bun run scripts/ci-native-desktop.ts",
		"verify:macos-bundle": "bun run scripts/verify-macos-bundle.ts",
		"finalize:macos-bundle": "bun run scripts/finalize-macos-bundle.ts",
		"verify:release-bundle": "bun run scripts/verify-release-bundle.ts",
		"authorize:macos-local": "bun run scripts/authorize-local-macos-app.ts",
		"verify:release-candidate": "bun run scripts/release-candidate.ts verify",
		"publish:release-candidate": "bun run scripts/publish-release.ts",
		"test:e2e": "vitest run --project e2e",
		"test:desktop:webdriver": "bun run scripts/smoke-embedded-webdriver.ts",
		"ci:desktop:prepare": "bun run scripts/ci-desktop.ts prepare",
		"ci:desktop:install": "bun run scripts/ci-desktop.ts install",
		"ci:desktop:build": "bun run scripts/ci-desktop.ts build",
		"ci:desktop:verify": "bun run scripts/ci-desktop.ts verify",
		"ci:desktop:archive": "bun run scripts/ci-desktop.ts archive",
		"check:dependencies": "bun run scripts/check-direct-dependencies.ts",
		"verify:desktop-toolchain": "bun run scripts/desktop-toolchain.ts verify",
		"install:workspace": "bun scripts/install-web-source-workspace.ts",
		"lint:types": "bun run typecheck",
		"lint:biome": "biome check --config-path=biome.json . --diagnostic-level=error",
		"lint:fix": "biome check --config-path=biome.json --write .",
		"lint:staged": "lint-staged",
		"hooks:install": "lefthook install",
		"test:bun": "bun scripts/bun-test-files.ts",
		"prepare:app-shell": "bun run --cwd ../app-shell build",
		"package:desktop:local": "bun scripts/package-desktop-local.ts"
	},
	"dependencies": {
		"@forgeax/agents": "0.1.0",
		"@forgeax/app-shell": "workspace:*",
		"@forgeax/chat": "workspace:*",
		"@forgeax/dashboard": "workspace:*",
		"@forgeax/editor": "workspace:*",
		"@forgeax/extension-gallery": "workspace:*",
		"@forgeax/extension-host": "0.3.2",
		"@forgeax/extension-platform": "0.7.0",
		"@forgeax/files": "workspace:*",
		"@forgeax/interface": "workspace:*",
		"@forgeax/settings": "workspace:*",
		"@forgeax/types": "^0.1.3",
		"@tauri-apps/api": "2.11.1",
		"@tauri-apps/plugin-shell": "2.3.6",
		"@google/model-viewer": "^4.2.0",
		"@radix-ui/react-alert-dialog": "^1.1.20",
		"@radix-ui/react-popover": "^1.1.20",
		"@radix-ui/react-tooltip": "^1.2.13",
		"cmdk": "^1.0.4",
		"@tauri-apps/plugin-clipboard-manager": "~2",
		"lucide-react": "0.460.0",
		"react": "19.1.9",
		"react-dom": "19.1.9",
		"react-markdown": "^10.1.0",
		"sharp": "0.34.5",
		"zustand": "5.0.13"
	},
	"optionalDependencies": {
		"@forgeax-extension/agent-ai-asset": "0.1.0",
		"@forgeax-extension/agent-animator-2d": "0.1.0",
		"@forgeax-extension/agent-audio-designer": "0.1.1",
		"@forgeax-extension/agent-cc-coder": "0.1.0",
		"@forgeax-extension/agent-claude-code-default": "0.1.0",
		"@forgeax-extension/agent-codex-default": "0.1.0",
		"@forgeax-extension/agent-cursor-default": "0.1.0",
		"@forgeax-extension/agent-director": "0.1.0",
		"@forgeax-extension/agent-gen3d": "0.1.1",
		"@forgeax-extension/agent-iro": "0.1.0",
		"@forgeax-extension/agent-kaede": "0.1.0",
		"@forgeax-extension/agent-kotone": "0.1.0",
		"@forgeax-extension/agent-kumo": "0.1.0",
		"@forgeax-extension/agent-lock": "0.1.0",
		"@forgeax-extension/agent-lowpoly": "0.1.1",
		"@forgeax-extension/agent-mira": "0.1.0",
		"@forgeax-extension/agent-mochi": "0.1.0",
		"@forgeax-extension/agent-monitor": "0.1.0",
		"@forgeax-extension/agent-nodia": "0.1.0",
		"@forgeax-extension/agent-persona": "0.1.0",
		"@forgeax-extension/agent-rin": "0.1.0",
		"@forgeax-extension/agent-sakura": "0.1.0",
		"@forgeax-extension/agent-suzu": "0.1.0",
		"@forgeax-extension/agent-tsumugi": "0.1.0",
		"@forgeax-extension/agent-ui-designer": "0.1.1",
		"@forgeax-extension/agent-vfx-artist-3d": "0.1.0",
		"@forgeax-extension/agent-yevi": "0.1.0",
		"@forgeax-extension/ai-asset": "0.1.4",
		"@forgeax-extension/animation": "0.1.32",
		"@forgeax-extension/bgm": "0.6.4",
		"@forgeax-extension/character-3d": "0.1.5",
		"@forgeax-extension/color-grading": "0.1.0",
		"@forgeax-extension/diffusion-renderer": "0.1.1",
		"@forgeax-extension/game-balance": "0.1.0",
		"@forgeax-extension/model-anthropic-text": "0.1.0",
		"@forgeax-extension/plugin-author": "0.1.0",
		"@forgeax-extension/reel": "0.2.0",
		"@forgeax-extension/scene-generator": "0.4.2",
		"@forgeax-extension/skill-effects": "0.1.1",
		"@forgeax-extension/skill-author-plugin": "0.1.0",
		"@forgeax-extension/skill-make-game-design": "0.1.0",
		"@forgeax-extension/team-forge": "0.1.0",
		"@forgeax-extension/source-navigation": "0.1.0",
		"@forgeax-extension/system-configuration": "0.1.0",
		"@forgeax-extension/tool-balance-resim": "0.1.0",
		"@forgeax-extension/game-video": "0.27.11"
	},
	"devDependencies": {
		"autoprefixer": "^10.4.20",
		"@tauri-apps/cli": "2.11.4",
		"@types/node": "22.20.1",
		"@types/react": "19.1.10",
		"@types/react-dom": "19.1.7",
		"@vitejs/plugin-react": "4.7.0",
		"bun-types": "1.3.14",
		"dockview": "6.6.1",
		"happy-dom": "20.10.2",
		"playwright-core": "1.62.1",
		"postcss": "^8.5.14",
		"tailwindcss": "^3.4.19",
		"tailwindcss-animate": "^1.0.7",
		"typescript": "5.9.2",
		"vite": "7.3.6",
		"vitest": "4.1.11",
		"yaml": "2.9.1",
		"webdriverio": "9.31.9",
		"@biomejs/biome": "2.5.13",
		"vite-plugin-checker": "0.14.5",
		"lefthook": "2.1.14",
		"lint-staged": "16.4.0"
	},
	"lint-staged": {
		"*": "biome check --config-path=biome.json --write --no-errors-on-unmatched --files-ignore-unknown=true"
	}
}
