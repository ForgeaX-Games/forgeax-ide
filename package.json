{
  "name": "@forgeax/ide",
  "version": "0.3.31-alpha.1",
  "packageManager": "bun@1.3.14",
  "private": true,
  "description": "ForgeaX Web and Desktop product assembly",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner --host 127.0.0.1",
    "dev:web": "vite --configLoader runner --host 127.0.0.1 --port 18920",
    "dev:desktop": "bun run scripts/dev-desktop.ts",
    "tauri": "tauri",
    "prepare:shader-build-inputs": "bun run scripts/ensure-shader-build-inputs.ts",
    "verify:shader-vite-contract": "bun run scripts/verify-shader-vite-contract.ts",
    "build:web": "bun run prepare:shader-build-inputs && bun run scripts/build-web.ts",
    "build:desktop": "bun run prepare:shader-build-inputs && bun run scripts/build-desktop.ts",
    "test": "bun test tests src-tauri/tests",
    "test:desktop:resources": "bun test src-tauri/tests",
    "typecheck": "bun run prepare:shader-build-inputs && tsc --noEmit -p tsconfig.lint.json",
    "lint": "bun run prepare:shader-build-inputs && tsc --noEmit -p tsconfig.lint.json",
    "diagnostics": "bun run scripts/diagnostics.ts",
    "check:release-sources": "bun run scripts/check-release-sources.ts",
    "release:preflight": "bun run scripts/release-preflight.ts",
    "sync:release-version": "bun run scripts/sync-release-version.ts",
    "resolve:release-context": "bun run scripts/resolve-release-context.ts",
    "verify:release-revisions": "bun run scripts/verify-release-revisions.ts",
    "stage:release-sidecar": "bun run scripts/stage-release-sidecar.ts",
    "artifact:manifest": "bun run scripts/artifact-manifest-cli.ts",
    "artifact:engine-runtime": "bun run scripts/engine-runtime-artifacts.ts",
    "artifact:web": "bun run scripts/web-runtime-artifact.ts",
    "artifact:desktop-runtime": "bun run scripts/runtime-artifacts.ts",
    "measure:release-stage": "bun run scripts/measure-release-stage.ts",
    "benchmark:release": "bun run scripts/release-benchmark.ts",
    "compose:desktop-resources": "bun run scripts/compose-desktop-resources.ts",
    "validate:desktop:resources": "bun run scripts/validate-desktop-resources.ts",
    "check:release-secrets": "bun run scripts/check-release-secrets.ts",
    "smoke:production-bundle": "node --experimental-strip-types scripts/smoke-production-bundle.ts",
    "verify:macos-bundle": "bun run scripts/verify-macos-bundle.ts",
    "verify:release-bundle": "bun run scripts/verify-release-bundle.ts",
    "authorize:macos-local": "bun run scripts/authorize-local-macos-app.ts",
    "verify:release-candidate": "bun run scripts/release-candidate.ts verify",
    "publish:release-candidate": "bun run scripts/publish-release.ts",
    "verify:provenance": "bun run scripts/verify-provenance.ts",
    "verify:main-provenance": "bun run scripts/verify-main-provenance.ts",
    "promote:main": "bun run scripts/promote-main.ts",
    "test:e2e": "bun test tests/e2e/ide-web-shell.spec.ts"
  },
  "dependencies": {
    "@forgeax/agents": "0.1.0",
    "@forgeax/app-shell": "0.85.0",
    "@forgeax/extension-platform": "0.4.0",
    "@google/model-viewer": "^4.2.0",
    "lucide-react": "0.460.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-markdown": "^10.1.0",
    "sharp": "0.34.5"
  },
  "optionalDependencies": {
    "@forgeax-extension/agent-monitor": "0.1.0",
    "@forgeax-extension/agent-persona": "0.1.0",
    "@forgeax-extension/ai-asset": "0.1.4",
    "@forgeax-extension/animation": "0.1.32",
    "@forgeax-extension/bgm": "0.6.0",
    "@forgeax-extension/character-3d": "0.1.5",
    "@forgeax-extension/color-grading": "0.1.0",
    "@forgeax-extension/diffusion-renderer": "0.1.1",
    "@forgeax-extension/game-balance": "0.1.0",
    "@forgeax-extension/model-anthropic-text": "0.1.0",
    "@forgeax-extension/plugin-author": "0.1.0",
    "@forgeax-extension/scene-generator": "0.2.1",
    "@forgeax-extension/skill-effects": "0.1.1",
    "@forgeax-extension/skill-author-plugin": "0.1.0",
    "@forgeax-extension/skill-make-game-design": "0.1.0",
    "@forgeax-extension/team-forge": "0.1.0",
    "@forgeax-extension/source-navigation": "0.1.0",
    "@forgeax-extension/system-configuration": "0.1.0",
    "@forgeax-extension/tool-balance-resim": "0.1.0",
    "@forgeax-extension/video-game": "0.20.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "4.7.0",
    "bun-types": "1.3.14",
    "playwright-core": "1.62.1",
    "typescript": "5.9.2",
    "vite": "7.1.3"
  }
}
